---
/**
 * 指標の取得元の公開ページ。
 *
 * 原本は docs/SOURCES.md。**片方だけ直さないこと。**
 *
 * 数字を出す媒体が取得元を隠すと、読者は検証できない。
 * 「判断の過程を残す」と掲げている以上、材料を開示する側に立つ。
 */
import Base from '../layouts/Base.astro';
import { listReports } from '../lib/content';
import { SITE_NAME } from '../config';

const reports = await listReports();
const latest = reports[0];

// FRED から取るもの。遅れは実測値
const FRED = [
  { name: '実質金利（TIPS10年）', id: 'DFII10', lag: '2営業日' },
  { name: 'VIX', id: 'VIXCLS', lag: '1営業日' },
  { name: '米10年債利回り', id: 'DGS10', lag: '2営業日' },
  { name: '米30年債利回り', id: 'DGS30', lag: '2営業日' },
  { name: '米2年債利回り', id: 'DGS2', lag: '2営業日' },
  { name: 'S&P 500', id: 'SP500', lag: '1営業日' },
  { name: '期待インフレ率（10年BEI）', id: 'T10YIE', lag: '2営業日' },
  { name: '米ハイイールド債スプレッド（ICE BofA OAS）', id: 'BAMLH0A0HYM2', lag: '1〜2営業日' },
  { name: '実効FF金利（FOMC の織り込みの起点）', id: 'EFFR', lag: '1営業日' },
];

const OTHERS = [
  { name: '金（XAU/USD）', src: 'USAGOLD 価格履歴（日別、山岳部時間15:00記録）', href: 'https://www.usagold.com/daily-gold-price-history/', note: '出所により水準が割れるため、定義を明記した1つの表に固定している。当日分は翌号で確定値と照合する' },
  { name: 'WTI・Brent原油', src: 'Yahoo Finance（期近先物の日足 CL=F / BZ=F）', href: 'https://finance.yahoo.com/quote/CL%3DF/', note: '終値は清算値。公的データは約1週間遅れるため、裏取りにのみ使う。限月交代の日は前日比が限月をまたぐ' },
  { name: 'ドル指数 DXY', src: 'Yahoo Finance（日足 DX-Y.NYB）', href: 'https://finance.yahoo.com/quote/DX-Y.NYB/', note: 'ICEの指数のため公的データベースに無い。取引所のデータを中継する集約サイトで一次の出所ではないが、報道ごとに割れる値を寄せ集めるより、1つの系列に固定することを取った' },
  { name: '日経225', src: 'Yahoo Finance（日足 ^N225）', href: 'https://finance.yahoo.com/quote/%5EN225/', note: '算出元の日経平均プロフィルと照合できるときは照合する' },
  { name: '日本10年債利回り', src: '財務省 国債金利情報', href: 'https://www.mof.go.jp/jgbs/reference/interest_rate/index.htm', note: '公的な確定値' },
  { name: '米2年・10年債利回り、実質金利（週次）', src: '米財務省 Daily Treasury Par Yield Curve / Real Yield Curve', href: 'https://home.treasury.gov/resource-center/data-chart-center/interest-rates/TextView?type=daily_treasury_yield_curve', note: 'FRED の DGS2・DGS10・DFII10 の原本。FRED より1営業日早く出るため、週次は金曜分までこちらで取る。2-10年スプレッドはこの2本の差' },
  { name: 'BTC', src: 'CoinGecko（CoinDeskで突き合わせ）', href: 'https://www.coingecko.com/en/coins/bitcoin', note: '24時間取引で終値が決まらないため、UTC 0:00（日本時間9:00）の値に固定している。週次は金曜の UTC 0:00 どうしで比べる' },
  { name: '日経VI', src: 'Yahoo Finance（日足 ^NKVI.OS）', href: 'https://finance.yahoo.com/quote/%5ENKVI.OS/', note: '算出元の日経平均プロフィルと照合できるときは照合する' },
  { name: 'Nasdaq総合・ダウ平均', src: 'Yahoo Finance（日足 ^IXIC / ^DJI）', href: '', note: 'S&P 500 と VIX は FRED が原本で、同じ系列から1日早く裏取りする' },
  { name: 'ドル円・ユーロドル', src: 'Yahoo Finance（1時間足 JPY=X / EURUSD=X）', href: 'https://finance.yahoo.com/quote/JPY%3DX/', note: 'その日のニューヨーク17時より前の最後の1時間足の終値。為替に取引所の引けは無く、慣行の区切りがニューヨーク17時のため。日足は前日の引け値が入って1日ずれるので使わない' },
  { name: '銀・プラチナ・銅', src: 'Yahoo Finance（COMEX / NYMEX 期近先物 SI=F / PL=F / HG=F）', href: 'https://finance.yahoo.com/quote/SI%3DF/', note: '清算値。現物の値決め（LBMA）は自動で取れないため、先物で定点化する。限月が替わった週の前週比は、同じ限月どうしで出す。銅の単位はドル/ポンド' },
  { name: '円建て金（XAU/JPY）', src: '算出：金（USAGOLD）× ドル円（ニューヨーク17時）', href: '', note: '1トロイオンスあたりの円。国内の店頭小売価格（田中貴金属など。1グラムあたり、税込）とは単位と定義が違い、参考として本文で触れるにとどめる' },
  { name: 'レシオ（金/銀・金/原油・金/銅）', src: '算出：COMEX 金先物（GC=F）÷ 銀・WTI原油・銅の期近先物', href: '', note: '比をとる両側を同じ種類の値（先物の清算値）にそろえる。各週の最後の取引日の値。限月が替わる週は比が限月をまたぐ' },
  { name: 'MOVE指数', src: 'Yahoo Finance（日足 ^MOVE）', href: 'https://finance.yahoo.com/quote/%5EMOVE/', note: 'ICE BofA の米国債のボラティリティ指数。VIX（株）・日経VI（日本株）と並べ、どの市場が震源かを見る' },
  { name: 'CFTC 建玉（COT）', src: 'CFTC Commitments of Traders（Disaggregated / Traders in Financial Futures）', href: 'https://publicreporting.cftc.gov/', note: '火曜時点の建玉を金曜に公表。金・銀・原油はマネージド・マネー、円はレバレッジド・ファンドの買い−売り' },
  { name: 'FOMC の織り込み', src: '算出：CBOT FF金利先物（Yahoo Finance）と FRED EFFR', href: 'https://www.cmegroup.com/markets/interest-rates/cme-fedwatch-tool.html', note: 'CME FedWatch と同じ考え方で、会合後の政策金利の見込みを先物から逆算する。FedWatch の数値そのものではない（FedWatch のページは自動で読めない）' },
  { name: 'BTC現物ETFの資金フロー', src: 'Farside Investors', href: 'https://farside.co.uk/btc/', note: '米国の現物ETFの日次ネットフローの合計（百万ドル）。集計前の日は「未集計」とする' },
  { name: '金ETF・銀ETFの残高', src: 'World Gold Council（週次）、SPDR Gold Shares（GLD）、iShares（IAU / SLV）の公式ページ', href: 'https://www.gold.org/goldhub/data/gold-etfs-holdings-and-flows', note: '自動で取れないため、公式ページか複数の報道で確かめた値だけを載せる。確かめられない週は「未確認」' },
  { name: 'LBMA の値決め（銀・プラチナ）', src: 'LBMA', href: 'https://www.lbma.org.uk/prices-and-data/precious-metal-prices', note: '現物の確定値の原本。自動で取れないため定点化には使わず、本文で現物に触れるときの照合先とする' },
];
---

<Base
  title="指標の取得元"
  description={`${SITE_NAME}（定点）が各指標をどこから取っているかの一覧。実質金利・VIX・米金利はFREDの系列IDまで明示し、反映の遅れも公開しています。数字を検証できる状態にしておくための資料です。`}
  breadcrumbs={[{ name: '指標の取得元' }]}
  quotes={latest?.data.snapshot ?? []}
  mastDate={latest?.data.date}
  mastNo={latest?.data.no}
>
  <div class="wrap">
    <header class="phead">
      <h1>指標の取得元</h1>
      <p class="deck">
        レポートに出てくる数字を、どこから取っているかの一覧です。同じ指標を同じ形式で記録し続けることを掲げている以上、<strong>取得元が日によって変われば、並べた数字は比較できなくなります。</strong>ここを固定し、公開しています。
      </p>
    </header>

    <div class="prose">
      <h2>原則</h2>
      <ul>
        <li><strong>系列を1つに固定する。</strong>同じ指標を日によって別の出所から取りません</li>
        <li><strong>値には必ず「いつ時点か」を添える。</strong>日付の無い数字は検証できません</li>
        <li><strong>取れなければ「未確認」と書く。</strong>近い数字で埋めません</li>
        <li>出所が食い違ったら、日付と具体性のあるほうを採ります。決まらなければ両方を併記し、未確認として扱います</li>
      </ul>

      <p>
        実際に、同じ日の金の終値が4つの出所で 4,290 / 4,304 / 4,314 / 4,318 ドルと割れたことがあります。前号と同じ系列を採ることで決着させました。<strong>水準そのものより、同じものさしで測り続けることのほうを優先します。</strong>
      </p>

      <h2>FRED（セントルイス連銀）から取るもの</h2>
      <p>系列IDを明記します。誰でも同じ値を確認できます。</p>

      <div class="table-scroll">
        <table class="src-table">
          <thead>
            <tr><th>指標</th><th>系列ID</th><th>反映の遅れ</th></tr>
          </thead>
          <tbody>
            {FRED.map((f) => (
              <tr>
                <td>{f.name}</td>
                <td class="mono">
                  <a href={`https://fred.stlouisfed.org/series/${f.id}`} target="_blank" rel="noopener noreferrer">{f.id}</a>
                </td>
                <td>{f.lag}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h3>遅れの扱い</h3>
      <p>
        これらは確定値のため、公表までに1〜2営業日かかります。<strong>遅れを理由に空欄にはしません。</strong>「9/28時点」と添えて載せ、翌号で確定値に差し替えます。いつの値かが分かれば、読者は自分で判断できます。
      </p>

      <h2>FRED以外から取るもの</h2>
      <p>
        FREDに無い、あるいは反映が遅すぎて日次に使えない指標です。公的機関や指数の算出元に日次の値があるものは、そこから取ります。報道から取るものは<strong>必ず複数の記事で突き合わせます。</strong>1社だけを信用しません。
      </p>

      <div class="table-scroll">
        <table class="src-table">
          <thead>
            <tr><th>指標</th><th>取得元</th><th>備考</th></tr>
          </thead>
          <tbody>
            {OTHERS.map((o) => (
              <tr>
                <td>{o.name}</td>
                <td>{o.href ? <a href={o.href} target="_blank" rel="noopener noreferrer">{o.src}</a> : o.src}</td>
                <td class="note">{o.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>なぜ公開しているか</h2>
      <p>
        数字を出す媒体が取得元を書かないと、読者はその数字を検証できません。結論だけを配る媒体にはしない、という方針を掲げている以上、<strong>材料を開示する側に立ちます。</strong>
      </p>
      <p>取得元を変更した場合は、この一覧とレポート本文の両方に反映します。</p>
    </div>
  </div>
</Base>

<style>
  .phead { padding: 48px 0 28px; }
  h1 { font-size: clamp(26px, 4vw, 36px); font-weight: 700; line-height: 1.4; }
  .deck { font-size: 15.5px; line-height: 1.9; color: var(--ink); margin-top: 16px; max-width: 46em; }

  .table-scroll { overflow-x: auto; margin: 20px 0 8px; }
  .src-table { border-collapse: collapse; width: 100%; font-size: 14.5px; }
  .src-table th, .src-table td {
    text-align: left; padding: 11px 14px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .src-table th {
    font-family: var(--sa); font-size: 12px; letter-spacing: .1em;
    color: var(--muted); font-weight: 700;
    border-bottom: 1px solid var(--line-2);
    white-space: nowrap;
  }
  .src-table td { line-height: 1.7; }
  .mono { font-family: var(--sa); white-space: nowrap; }
  .note { color: var(--ink); font-size: 13.5px; }
</style>
