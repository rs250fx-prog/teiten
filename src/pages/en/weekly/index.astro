---
import Base from '../../../layouts/Base.astro';
import WeeklyCard from '../../../components/WeeklyCard.astro';
import { listWeeklyEn } from '../../../lib/content';
import { EN, EN_WEEKLY as W } from '../../../i18n';

const weekly = await listWeeklyEn();
---

<Base
  lang="en"
  alternate="/weekly/"
  title={W.title}
  description={W.lead}
  breadcrumbs={[{ name: W.title }]}
>
  <div class="wrap">
    <header class="phead">
      <h1>{W.title}</h1>
      <p>{W.lead}</p>
      <p class="ja">{W.dailyJa} <a href="/reports/" hreflang="ja">{EN.footer.japanese} →</a></p>
      <div class="count num">{W.count(weekly.length)}</div>
    </header>

    {weekly.length > 0 ? (
      <div class="wk">
        {weekly.map((entry) => <WeeklyCard entry={entry} lang="en" />)}
      </div>
    ) : (
      <p class="empty">{W.empty}</p>
    )}
  </div>
</Base>

<style>
  .phead { padding: 48px 0 34px; border-bottom: 1px solid var(--line); }
  h1 {
    font-family: var(--se);
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 18px;
  }
  .phead p { font-size: 15.5px; line-height: 1.9; font-weight: 400; color: var(--ink-2); max-width: 62ch; }
  .phead .ja { font-size: 13.5px; color: var(--muted); margin-top: 12px; }
  .phead .ja a { color: var(--accent); }
  .count { font-size: 12px; color: var(--muted); margin-top: 18px; }
  .wk {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    padding: 44px 0 60px;
    border-bottom: 1px solid var(--line);
  }
  @media (max-width: 860px) { .wk { grid-template-columns: 1fr; } }
  .empty { padding: 80px 0; text-align: center; color: var(--muted); border-bottom: 1px solid var(--line); }
</style>
