---
/**
 * 世界の定点の英語版の記事ページ。日本語の /world/<slug>/ と同じ骨組みで、
 * 本文は src/content/world-en/<slug>.md、枠の文言は src/i18n.ts。
 * 日本語版が無い号は作らない（check-report.py が突き合わせる）。
 */
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Snapshot from '../../../components/Snapshot.astro';
import RailList from '../../../components/RailList.astro';
import WorldWindows from '../../../components/WorldWindows.astro';
import WorldGrid from '../../../components/WorldGrid.astro';
import WorldReview from '../../../components/WorldReview.astro';
import { allWorldEn, allWorld, listWeekly, monthDay, longDateEn, isoJst } from '../../../lib/content';
import { actuals } from '../../../lib/world';
import { EN } from '../../../i18n';
import { SITE_URL, OPERATOR, PUBLISHER_URL, EDITOR } from '../../../config';

export async function getStaticPaths() {
  const entries = await allWorldEn();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const act = actuals(entry.id, 'en');
const railQuotes = act.map((a) => ({ label: a.label, value: a.text, change: `as of ${a.asof.slice(5).replace('-', '/')}`, dir: a.dir }));

// 日本語の原本があるときだけ hreflang と「Japanese original」を出す
const ja = (await allWorld()).find((w) => w.id === entry.id);
const alternate = ja ? `/world/${entry.id}/` : undefined;
const weekly = await listWeekly();
const sameWeek = weekly.find((w) => w.id === entry.id);
const railItems = sameWeek
  ? [{ href: `/weekly/${sameWeek.id}/`, meta: `WEEK ${sameWeek.data.week} (Japanese)`, title: sameWeek.data.title }]
  : [];

const pageUrl = new URL(`/en/world/${entry.id}/`, SITE_URL).href;
const modifiedIso = isoJst(d.date ?? d.end, d.updated);
const schema = [
  {
    '@type': 'NewsArticle',
    '@id': `${pageUrl}#article`,
    headline: d.title,
    description: d.description || d.deck,
    datePublished: d.date ?? d.end,
    dateModified: modifiedIso ?? d.date ?? d.end,
    inLanguage: 'en',
    isAccessibleForFree: d.access === 'public',
    articleSection: EN.world.title,
    keywords: d.tags.join(', '),
    url: pageUrl,
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    image: new URL(d.ogImage ?? '/og-default.png', SITE_URL).href,
    author: {
      '@type': 'Person',
      name: EDITOR.name,
      jobTitle: 'Editor',
      url: `${SITE_URL}/en/about/#editor`,
      worksFor: { '@type': 'Organization', name: OPERATOR.name, url: PUBLISHER_URL },
    },
    publisher: { '@id': `${SITE_URL}/#organization` },
    isPartOf: { '@id': `${SITE_URL}/#website` },
    ...(alternate ? { translationOfWork: { '@type': 'NewsArticle', '@id': `${new URL(alternate, SITE_URL).href}#article` } } : {}),
  },
];
const breadcrumbs = [{ name: EN.world.title, path: '/en/world/' }, { name: d.title }];
---

<Base
  lang="en"
  alternate={alternate}
  title={d.title}
  description={d.description || d.deck}
  type="article"
  ogImage={d.ogImage}
  publishedTime={d.date ?? d.end}
  modifiedTime={modifiedIso}
  unlisted={d.unlisted}
  schema={schema}
  breadcrumbs={breadcrumbs}
>
  <div class="wrap">
    <div class="article-layout">
    <div class="article-main">
    <article>
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/en/">{EN.home}</a>
        <span aria-hidden="true">/</span>
        <a href="/en/world/">{EN.world.title}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{EN.world.week} {d.week}</span>
      </nav>

      <header class="head">
        <div class="rubric">
          <span class="num">{EN.world.week} {d.week}</span>
          <span class="rule" aria-hidden="true"></span>
          <span class="num">{monthDay(d.start)} — {monthDay(d.end)}</span>
        </div>
        <h1>{d.title}</h1>
        <p class="deck">{d.deck}</p>
        <div class="by">
          <span>Financial and Marketing M16</span>
          <span>{EN.world.editor}: <a href="/en/about/#editor">{EDITOR.name}</a></span>
          <span>{EN.world.published} {longDateEn(d.date ?? d.end)}</span>
          {d.updated && <span>{EN.world.updated} {d.updated}</span>}
        </div>
        {d.tags.length > 0 && (
          <div class="tags plain">
            {d.tags.map((t) => <span>{t}</span>)}
          </div>
        )}
        {alternate && (
          <p class="tr">{EN.world.translated} <a href={alternate} hreflang="ja">{EN.world.original}</a></p>
        )}
      </header>

      {d.points.length > 0 && (
        <section class="points" aria-label={EN.world.points}>
          <div class="points-h">{EN.world.points}</div>
          <ol>
            {d.points.map((p) => <li>{p}</li>)}
          </ol>
        </section>
      )}

      <WorldWindows windows={d.windows} physicalNotes={d.physicalNotes} lang="en" />

      <WorldGrid windows={d.windows} lang="en" />

      <WorldReview review={d.review} actuals={act} lang="en" />

      <div class="prose">
        <Content />
      </div>

      <section class="how" aria-label={EN.world.how}>
        <div class="how-h">{EN.world.how}</div>
        <p>{EN.world.howText}</p>
      </section>
    </article>
    </div>

    <aside class="article-rail">
      <div class="article-rail-in">
        {railQuotes.length > 0 && (
          <div class="rail-only">
            <Snapshot quotes={railQuotes} variant="list" heading={EN.world.railQuotes} />
          </div>
        )}
        {railItems.length > 0 && (
          <RailList
            heading={EN.world.railWeekly}
            items={railItems}
            moreHref="/weekly/"
            moreLabel={EN.world.railWeeklyMore}
            clamp={2}
          />
        )}
      </div>
    </aside>
    </div>
  </div>
</Base>

<style>
  article { padding-top: 34px; }
  .crumb {
    display: flex; gap: 9px; flex-wrap: wrap;
    font-family: var(--sa); font-size: 12.5px; color: var(--muted); margin-bottom: 22px;
  }
  .crumb a:hover { color: var(--accent); }
  .rubric {
    display: flex; align-items: center; gap: 12px;
    font-family: var(--sa); font-size: 11px; letter-spacing: .14em; color: var(--accent); margin-bottom: 20px;
  }
  .rubric .rule { flex: 1; height: 1px; background: var(--line); display: block; }
  h1 {
    font-family: var(--se);
    font-size: clamp(27px, 4vw, 44px);
    font-weight: 700; line-height: 1.3; margin-bottom: 22px; max-width: 28ch;
    text-wrap: balance;
  }
  .deck { font-size: 17px; line-height: 1.8; font-weight: 400; color: var(--ink-2); max-width: 62ch; margin-bottom: 26px; }
  .by {
    display: flex; gap: 16px; flex-wrap: wrap;
    font-family: var(--sa); font-size: 11.5px; color: var(--muted);
    padding-top: 18px; border-top: 1px solid var(--line);
  }
  .tags { margin-top: 14px; }
  /* 英語版のタグはトピックページ（日本語）に飛ばさない。飾りのチップだけ */
  .tags.plain span {
    display: inline-block; font-family: var(--sa); font-size: 11.5px; color: var(--muted);
    border: 1px solid var(--line-2); border-radius: 999px; padding: 2px 10px; margin: 0 6px 6px 0;
  }
  .tr { margin-top: 12px; font-size: 13px; color: var(--muted); }
  .tr a { color: var(--accent); }
  .prose { max-width: 68ch; padding: 34px 0 0; }

  .points { margin: 34px 0 0; background: var(--surface-2); border-radius: var(--r); padding: 28px 32px; }
  .points-h {
    font-family: var(--sa); font-size: 10.5px; letter-spacing: .16em; color: var(--muted);
    padding-bottom: 12px; margin-bottom: 4px; border-bottom: 1px solid var(--line-2);
  }
  .points ol { list-style: none; counter-reset: pt; }
  .points li {
    counter-increment: pt;
    display: grid; grid-template-columns: 34px 1fr; gap: 6px; align-items: baseline;
    padding: 14px 0; border-bottom: 1px solid var(--line);
    font-size: 15px; line-height: 1.8; color: var(--ink-2);
  }
  .points li:last-child { border-bottom: 0; }
  .points li::before {
    content: counter(pt, decimal-leading-zero);
    font-family: var(--sa); font-size: 10.5px; letter-spacing: .1em; color: var(--accent);
  }

  .how {
    margin: 10px 0 56px; max-width: 68ch;
    background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--accent);
    border-radius: var(--r); padding: 22px 26px;
  }
  .how-h { font-family: var(--sa); font-size: 10.5px; letter-spacing: .16em; color: var(--accent); margin-bottom: 10px; }
  .how p { font-size: 14px; line-height: 1.85; color: var(--ink); }
</style>
