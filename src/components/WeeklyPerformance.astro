---
/**
 * 各資産の週次パフォーマンス。
 *
 * 日次のスナップショットは「いまの値」を並べる数値ボードだが、
 * 週次は値に寸評が付く。1週間を振り返る記事なので、数字だけでは
 * 何が起きたのかが伝わらないため。
 *
 * 2026-10-27 から銘柄を倍に増やしたので、貴金属・金利・為替…のグループに分けて並べる。
 * group の無い W43 までの行は label から振り分ける（src/lib/weekly.ts の inferGroup）。
 */
import { GROUPS, inferGroup, type GroupKey } from '../lib/weekly';

interface Row {
  label: string;
  value: string;
  change: string;
  dir: 'up' | 'down' | 'flat';
  note: string;
  group?: GroupKey;
  status?: '確定' | '読み取り' | '未確認';
}
interface Props {
  rows: Row[];
}
const { rows } = Astro.props;

const tagged = rows.map((r) => ({ ...r, g: r.group ?? inferGroup(r.label) }));
const sections = [
  ...GROUPS.map((g) => ({ label: g.label, rows: tagged.filter((r) => r.g === g.key) })),
  { label: 'その他', rows: tagged.filter((r) => !r.g) },
].filter((s) => s.rows.length > 0);
// 1グループに1銘柄ずつしかない旧い週は、見出しを立てると細切れになる
const grouped = sections.length > 1 && sections.length < tagged.length;
---

{rows.length > 0 && (
  <section class="perf" aria-label="各資産の週次パフォーマンス">
    <div class="sec-head">
      <h2>各資産の週次パフォーマンス</h2>
      <span class="spacer"></span>
      <span class="num">{rows.length} 銘柄</span>
    </div>
    {(grouped ? sections : [{ label: '', rows: tagged }]).map((s) => (
      <div class="grp">
        {s.label && <h3 class="grp-h">{s.label}</h3>}
        <ul>
          {s.rows.map((r) => (
            <li>
              <span class="label">{r.label}</span>
              <span class:list={['value', (r.status === '未確認' || !r.value) && 'unk']}>
                {r.status === '未確認' || !r.value ? '未確認' : r.value}
              </span>
              <span class="right">
                {r.change && r.status !== '未確認' && <span class:list={['change', r.dir]}>{r.change}</span>}
                {r.status === '読み取り' && <span class="badge" title="取引中・集計途中の値で、終値ではない">読み取り</span>}
              </span>
              {r.note && <span class="note">{r.note}</span>}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
)}

<style>
  .perf { margin: 34px 0 44px; }
  .grp + .grp { margin-top: 22px; }
  .grp-h {
    font-family: var(--sa);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .16em;
    color: var(--accent);
    padding: 4px 0 8px;
    border-bottom: 1px solid var(--line-2);
  }
  ul { list-style: none; }
  /* 1段目に銘柄・値・変化、2段目に寸評。記事ページは本文幅（730px）なので、
     寸評を4列目に置くと1行が20字ほどになり細かく折り返す */
  li {
    display: grid;
    grid-template-columns: 150px 120px 1fr;
    gap: 6px 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  li > * { min-width: 0; }
  li:last-child { border-bottom: 0; }
  .label {
    font-family: var(--sa);
    font-size: 12.5px;
    color: var(--muted);
    letter-spacing: .02em;
  }
  .value {
    font-family: var(--sa);
    font-size: 17px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.01em;
  }
  .value.unk { font-size: 13px; color: var(--muted); font-weight: 400; }
  .right { display: inline-flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
  .change {
    font-family: var(--sa);
    font-size: 13px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .change.up { color: var(--up); }
  .change.down { color: var(--down); }
  .change.flat { color: var(--muted); }
  .badge {
    font-family: var(--sa);
    font-size: 10.5px;
    letter-spacing: .06em;
    color: var(--muted);
    border: 1px solid var(--line-2);
    border-radius: 3px;
    padding: 1px 6px;
  }
  .note {
    grid-column: 2 / -1;
    font-size: 14px;
    line-height: 1.8;
    color: var(--ink-2);
  }

  /* 狭い幅では、銘柄名と値を1行目に、寸評を下へ回す */
  @media (max-width: 760px) {
    li {
      grid-template-columns: 1fr auto auto;
      gap: 4px 12px;
    }
    .label { grid-area: 1 / 1; }
    .value { grid-area: 1 / 2; font-size: 16px; }
    .right { grid-area: 1 / 3; }
    .note { grid-column: 1 / -1; font-size: 13.5px; }
  }
</style>
