---
import {
  IS_PUBLIC,
  SITE_URL,
  SITE_NAME,
  SITE_NAME_JA,
  SITE_DESCRIPTION,
  PUBLISHER_URL,
  OPERATOR,
} from '../config';
import { EN, type Lang } from '../i18n';

interface Crumb {
  name: string;
  /** サイト内の絶対パス。末尾の項目（現在地）は省略する */
  path?: string;
}

interface Props {
  title?: string;
  description?: string;
  /** 記事ページなら 'article' */
  type?: 'website' | 'article';
  ogImage?: string;
  publishedTime?: string;
  modifiedTime?: string;
  /** frontmatter の unlisted。true なら noindex */
  unlisted?: boolean;
  /** 公開後も恒久的に noindex にするページ（404 など） */
  noindex?: boolean;
  /** 記事ページ用の追加スキーマ。@graph に連結される */
  schema?: Record<string, unknown>[];
  /** パンくず。ホームは自動で先頭に付くので渡さない */
  breadcrumbs?: Crumb[];
  /** 言語。英語版のページは 'en' */
  lang?: Lang;
  /** 対になる別言語のページのパス。あれば hreflang を相互に出す */
  alternate?: string;
}

const {
  title,
  description: descriptionProp,
  type = 'website',
  ogImage = '/og-default.png',
  publishedTime,
  modifiedTime,
  unlisted = false,
  noindex: forceNoindex = false,
  schema = [],
  breadcrumbs = [],
  lang = 'ja',
  alternate,
} = Astro.props;

const description = descriptionProp ?? (lang === 'en' ? EN.siteDescription : SITE_DESCRIPTION);
// 「TEITEN」だけでは日本語検索に引っかからないため、漢字表記を併記する。英語版はローマ字だけ
const brand = lang === 'en' ? SITE_NAME : `${SITE_NAME}（${SITE_NAME_JA}）`;
const pageTitle = title
  ? `${title} | ${brand}`
  : lang === 'en' ? `${brand} — ${EN.tagline}` : `${brand} — 資金の流れで読む、今日の市場`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogUrl = new URL(ogImage, SITE_URL).href;

// hreflang。対になるページがあるときだけ、自分と相手と x-default（日本語）を出す
const hreflangs = alternate
  ? [
      { lang, href: canonical },
      { lang: lang === 'en' ? 'ja' : 'en', href: new URL(alternate, SITE_URL).href },
      { lang: 'x-default', href: lang === 'ja' ? canonical : new URL(alternate, SITE_URL).href },
    ]
  : [];

// 本公開前・unlisted 記事・恒久 noindex ページは検索エンジンに載せない
const noindex = !IS_PUBLIC || unlisted || forceNoindex;

/**
 * 構造化データ。@graph に束ねて1本の JSON-LD として出す。
 * @id で相互参照させることで、ページをまたいで同じ WebSite /
 * Organization を指していることを検索エンジンに伝える。
 */
const siteId = `${SITE_URL}/#website`;
const orgId = `${SITE_URL}/#organization`;

const baseGraph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': siteId,
    url: `${SITE_URL}/`,
    name: SITE_NAME,
    alternateName: [SITE_NAME_JA, `${SITE_NAME}（${SITE_NAME_JA}）`],
    description: SITE_DESCRIPTION,
    inLanguage: 'ja',
    publisher: { '@id': orgId },
  },
  {
    '@type': 'Organization',
    '@id': orgId,
    name: OPERATOR.name,
    url: PUBLISHER_URL,
    // OG画像は共有用のバナーであってロゴではない。
    // Organization.logo には正方形の専用画像を使う
    logo: {
      '@type': 'ImageObject',
      url: new URL('/logo.png', SITE_URL).href,
      width: 512,
      height: 512,
    },
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'JP',
      addressRegion: '東京都',
      streetAddress: OPERATOR.address,
    },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      url: OPERATOR.contactUrl,
    },
  },
];

// パンくずは常にホームから始める
const crumbGraph =
  breadcrumbs.length > 0
    ? [
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          itemListElement: [
            lang === 'en' ? { name: EN.home, path: '/en/' } : { name: 'ホーム', path: '/' },
            ...breadcrumbs,
          ].map(
            (c, i) => ({
              '@type': 'ListItem',
              position: i + 1,
              name: c.name,
              ...(c.path ? { item: new URL(c.path, SITE_URL).href } : {}),
            }),
          ),
        },
      ]
    : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...baseGraph, ...crumbGraph, ...schema],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}

{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ja_JP'} />
{alternate && <meta property="og:locale:alternate" content={lang === 'en' ? 'ja_JP' : 'en_US'} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{IS_PUBLIC && <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />}

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
