---
import { NAV, SUBSCRIBE_ENABLED } from '../config';
import { EN, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
  /** 対になる別言語のページ。あれば言語の切り替えリンクを出す */
  alternate?: string;
}
const { lang = 'ja', alternate } = Astro.props;

const path = Astro.url.pathname;
// 英語版は /en/ の下に置くので、ホームの判定は言語ごとに変える
const items: readonly { href: string; label: string }[] = lang === 'en' ? EN.nav : NAV;
const isCurrent = (href: string) =>
  href === '/' || href === '/en/' ? path === href : path.startsWith(href);
// 言語の切り替え。対になるページが無ければ、相手の言語のトップへ
const switchHref = alternate ?? (lang === 'en' ? '/' : '/en/');
const switchLabel = lang === 'en' ? EN.langSwitch.label : 'English';
const switchTitle = lang === 'en' ? EN.langSwitch.title : '英語版';
---

<div class="navbar">
  <div class="wrap">
    <div class="bar">
      <nav class="links" aria-label={lang === 'en' ? 'Site navigation' : 'サイト内ナビゲーション'}>
        {items.map((item) => (
          <a
            href={item.href}
            class:list={['item', { on: isCurrent(item.href) }]}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >{item.label}</a>
        ))}
      </nav>
      <div class="actions">
        <a class="lang" href={switchHref} title={switchTitle} hreflang={lang === 'en' ? 'ja' : 'en'}>{switchLabel}</a>
        <button class="icon" id="theme-toggle" type="button" aria-label={lang === 'en' ? EN.themeToggle : '配色を切り替える'}>
          <span aria-hidden="true">◐</span>
        </button>
        {SUBSCRIBE_ENABLED && lang === 'ja' && <a class="sub-btn" href="/#subscribe">購読する</a>}
      </div>
    </div>
  </div>
</div>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(14px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 52px;
  }
  /* リンク側だけを横スクロールさせる。購読ボタンは常に見える位置に残す */
  .links {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .links::-webkit-scrollbar { display: none; }
  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }
  .item {
    /* flex: none を外すと、狭い幅で項目が縮んで文字が重なる。
       横スクロールで逃がすため、縮小を止めておく */
    flex: none;
    font-family: var(--sa);
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    padding: 7px 13px;
    border-radius: 999px;
    transition: .16s;
  }
  .item:hover { color: var(--ink); background: var(--surface-2); }
  .item.on { color: var(--ink); background: var(--surface-2); font-weight: 500; }
  .icon {
    width: 34px; height: 34px;
    flex: none;
    border: 1px solid var(--line-2);
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: none;
    color: var(--ink);
    font-size: 13px;
    cursor: pointer;
    transition: .16s;
  }
  .icon:hover { background: var(--surface-2); }
  /* 言語の切り替え。ナビの項目と同じ重さで、右端にまとめる */
  .lang {
    flex: none;
    font-family: var(--sa);
    font-size: 12.5px;
    color: var(--muted);
    padding: 6px 11px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    white-space: nowrap;
    transition: .16s;
  }
  .lang:hover { color: var(--ink); background: var(--surface-2); }
  .sub-btn {
    flex: none;
    font-family: var(--sa);
    font-size: 13px;
    font-weight: 500;
    background: var(--ink);
    color: var(--bg);
    padding: 9px 18px;
    border-radius: 999px;
    white-space: nowrap;
    transition: opacity .16s;
  }
  .sub-btn:hover { opacity: .84; }
</style>

<script>
  // 保存値の復元は Base.astro の <head> 内で先に済ませている
  // （ここで読むと、既定配色で一度描画されてからちらつくため）。
  // 選択した配色は端末内にのみ残る。private window やストレージ拒否時は
  // 例外になるため、書き込みは try/catch で包む。
  const KEY = 'frm16-theme';
  const root = document.documentElement;

  const prefersDark = () =>
    window.matchMedia('(prefers-color-scheme: dark)').matches;

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const now = root.getAttribute('data-theme') ?? (prefersDark() ? 'dark' : 'light');
    const next = now === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem(KEY, next); } catch { /* 保存できなくても切替は効く */ }
  });
</script>
