---
/**
 * 一覧用のカード。週次の WeeklyCard と同じ形で、6窓の金の論調を小さく添える。
 */
import type { World } from '../lib/content';
import { monthDay } from '../lib/content';
import { STANCE, REGIONS } from '../lib/world';

interface Props { entry: World }
const { entry } = Astro.props;
const { week, start, end, title, deck, windows } = entry.data;
const golds = REGIONS.map((r) => {
  const w = windows.find((x) => x.region === r.key);
  return { label: r.label, stance: w?.gold?.stance ?? 'unknown' };
});
---

<a class="wc" href={`/world/${entry.id}/`}>
  <div class="w">WEEK {week} — {monthDay(start)} / {monthDay(end)}</div>
  <h3>{title}</h3>
  <p>{deck}</p>
  <ul class="g" aria-label="金の論調">
    {golds.map((g) => (
      <li class={g.stance} title={`${g.label}：${STANCE[g.stance].label}`}>
        <span class="r">{g.label}</span><span class="m">{STANCE[g.stance].mark || '·'}</span>
      </li>
    ))}
  </ul>
  <span class="go">読む →</span>
</a>

<style>
  .wc {
    display: flex; flex-direction: column; gap: 11px;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r);
    padding: 28px; transition: .2s;
  }
  .wc:hover { border-color: var(--line-2); transform: translateY(-2px); }
  .w { font-family: var(--sa); font-size: 11px; letter-spacing: .1em; color: var(--accent); font-variant-numeric: tabular-nums; }
  h3 { font-family: var(--se); font-size: 19px; font-weight: 500; line-height: 1.6; }
  p { font-size: 13.5px; line-height: 1.9; font-weight: 400; color: var(--muted); }
  .g { list-style: none; display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
  .g li {
    display: inline-flex; gap: 4px; align-items: center;
    font-family: var(--sa); font-size: 11px; padding: 1px 7px; border-radius: 3px;
    background: var(--surface-2); color: var(--muted);
  }
  .g li.bull { color: var(--up); } .g li.bear { color: var(--down); } .g li.split { color: var(--accent); }
  .g li.unknown { border: 1px dashed var(--line-2); background: transparent; }
  .g .m { font-size: 9px; }
  .go { margin-top: auto; padding-top: 12px; font-family: var(--sa); font-size: 12.5px; color: var(--accent); }
  @media (prefers-reduced-motion: reduce) { .wc:hover { transform: none; } }
</style>
